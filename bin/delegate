#!/usr/bin/env bash
# delegate — hand a bounded task to a worker model; see `delegate --help`. Implementation: lib/delegate.js
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || python3 -I -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"
command -v node >/dev/null 2>&1 || { echo "delegate: Node.js 18+ is required" >&2; exit 3; }
exec node "$here/lib/delegate.js" "$@"
