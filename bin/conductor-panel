#!/usr/bin/env bash
# conductor-panel — the Conductor dashboard (http://127.0.0.1:4747) and its office (Pixel Agents, :4748)
# usage: conductor-panel [open|start|stop|restart|status]
#        conductor-panel office [start|stop|status|roster]
set -uo pipefail
CONF_ENV="${CONDUCTOR_CONFIG:-$HOME/.config/conductor/conductor.env}"
# shellcheck disable=SC1090
[ -r "$CONF_ENV" ] && . "$CONF_ENV"
ROOT="${CONDUCTOR_HOME:-$HOME/.claude/conductor}"; mkdir -p "$ROOT"
PORT="${CONDUCTOR_PANEL_PORT:-4747}"
OPORT="${CONDUCTOR_OFFICE_PORT:-4748}"
URL="http://127.0.0.1:$PORT"
OURL="http://127.0.0.1:$OPORT"
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || python3 -I -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")/.." && pwd)"

up() { curl -fsS --max-time 1 "$1/api/health" >/dev/null 2>&1; }

# ── dashboard ──
start() {
  up "$URL" && { echo "conductor-panel: dashboard running at $URL"; return 0; }
  command -v node >/dev/null || { echo "conductor-panel: node not found" >&2; return 3; }
  CONDUCTOR_PANEL_PORT="$PORT" CONDUCTOR_OFFICE_PORT="$OPORT" \
    nohup node "$here/dashboard/server.js" >>"$ROOT/dashboard.log" 2>&1 </dev/null &
  disown 2>/dev/null || true
  for _ in $(seq 1 40); do up "$URL" && break; sleep 0.25; done
  if up "$URL"; then echo "conductor-panel: dashboard started at $URL"; else echo "conductor-panel: failed — see $ROOT/dashboard.log" >&2; return 1; fi
}
stop() {
  local p; p="$(pgrep -f "node $here/dashboard/server.js" 2>/dev/null)"
  [ -z "$p" ] && { echo "conductor-panel: dashboard not running"; return 0; }
  kill $p 2>/dev/null && echo "conductor-panel: dashboard stopped"
}

# ── office (Pixel Agents) ──
roster() {  # seat every usable worker as an idle character
  local w=()
  command -v agy >/dev/null && w+=(Gemini)
  command -v cursor-agent >/dev/null && w+=(Cursor)
  command -v copilot >/dev/null && w+=(Copilot)
  [ -r "${CONDUCTOR_LOCAL_ENV:-$HOME/.config/conductor/local.env}" ] && w+=(Local)
  [ ${#w[@]} -gt 0 ] && python3 -I "$here/scripts/pixel-bridge.py" roster "${w[@]}" >/dev/null 2>&1
  return 0
}
office_start() {
  up "$OURL" && { echo "office: running at $OURL"; return 0; }
  command -v pixel-agents >/dev/null || { echo "office: pixel-agents not installed — npm install -g pixel-agents" >&2; return 3; }
  # one-name labels (Claude / Gemini / Cursor …); re-applied after a pixel-agents update
  python3 -I "$here/scripts/patch-pixel-agents.py" >>"$ROOT/pixel-agents.log" 2>&1
  # workers are external sessions: Pixel Agents only adopts them with "Watch All Sessions" on
  [ "${CONDUCTOR_PIXEL_CONFIG:-1}" != 0 ] && python3 -I - "$HOME/.pixel-agents/config.json" <<'PY' >>"$ROOT/pixel-agents.log" 2>&1
import json, os, sys
p = sys.argv[1]
try: d = json.load(open(p))
except Exception: d = {}
s = d.setdefault("standalone", {})
changed = False
for k in ("watchAllSessions", "alwaysShowLabels"):
    if k not in s: s[k] = True; changed = True
if s.get("watchAllSessions") is False: print("office: watchAllSessions is off in", p, "- worker characters will not appear")
if changed:
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(d, open(p, "w"), indent=2); os.chmod(p, 0o600)
PY
  nohup pixel-agents --port "$OPORT" >>"$ROOT/pixel-agents.log" 2>&1 </dev/null &
  disown 2>/dev/null || true
  for _ in $(seq 1 40); do up "$OURL" && break; sleep 0.25; done
  if up "$OURL"; then roster; echo "office: started at $OURL"; else echo "office: failed — see $ROOT/pixel-agents.log" >&2; return 1; fi
}
office_stop() {
  local p; p="$(pgrep -f "pixel-agents --port $OPORT" 2>/dev/null)"
  [ -z "$p" ] && { echo "office: not running"; return 0; }
  kill $p 2>/dev/null && echo "office: stopped"
}

case "${1:-open}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 0.5; start ;;
  status) if up "$URL"; then echo "dashboard: running at $URL"; else echo "dashboard: stopped"; fi
          if up "$OURL"; then echo "office: running at $OURL"; else echo "office: stopped"; fi ;;
  open) start >/dev/null && { if command -v open >/dev/null; then open "$URL"; elif command -v xdg-open >/dev/null; then xdg-open "$URL" >/dev/null 2>&1; fi; echo "$URL"; } ;;
  office)
    case "${2:-status}" in
      start) office_start ;;
      stop) office_stop ;;
      restart) office_stop; sleep 1; office_start ;;
      roster) up "$OURL" && roster ;;
      status) if up "$OURL"; then echo "office: running at $OURL"; else echo "office: stopped"; fi ;;
      *) echo "usage: conductor-panel office [start|stop|restart|status|roster]" >&2; exit 2 ;;
    esac ;;
  -h|--help|help) sed -n '2,4p' "$0" | sed 's/^# //' ;;
  *) echo "usage: conductor-panel [open|start|stop|restart|status] | office [start|stop|status]" >&2; exit 2 ;;
esac
